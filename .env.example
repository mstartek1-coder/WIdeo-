# Skopiuj do .env i uzupełnij klucze, których chcesz używać.
# Każdy dostawca jest opcjonalny – bez kluczy działa silnik proceduralny i reżyser offline.

# Reżyser AI (scenariusz + prompty) – Claude
ANTHROPIC_API_KEY=
# DIRECTOR_MODEL=claude-opus-5

# Wideo/obrazy AI przez Replicate (Veo 3, Kling, Hailuo, Seedance, Flux...)
REPLICATE_API_TOKEN=

# Google Veo przez Gemini API (wideo z natywnym dźwiękiem)
GEMINI_API_KEY=
# VEO_MODEL=veo-3.0-generate-001

# ElevenLabs – lektor (TTS), efekty dźwiękowe i muzyka
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Serwer
# HOST=127.0.0.1
# PORT=5173
